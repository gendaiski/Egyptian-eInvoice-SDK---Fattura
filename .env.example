# Fatura server configuration. Copy to .env (never commit real values).

# Postgres connection string. Leave empty to use the embedded Postgres (PGlite) in PGLITE_DIR.
# Production: use a managed Postgres (Neon, Supabase, RDS, Azure Database for PostgreSQL).
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# 32+ random characters. Signs session cookies and agent tokens.
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
APP_SECRET=
# 32 random bytes, base64. Encrypts ETA client secrets and signing keys at rest (AES-256-GCM).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Protects POST /api/cron/tick when an external scheduler calls it.
CRON_SECRET=

# Seed the demo tenant and test logins on an empty database (turn off in production).
SEED_DEMO=true

# Allowed browser origins when the front end is hosted on another domain (comma-separated).
CORS_ORIGINS=

PORT=8787
# Set to "off" to disable the in-process worker (e.g. when an external cron calls /api/cron/tick).
WORKER=on

# Optional: override ETA hosts (e.g. the SIT environment).
ETA_ID_URL=
ETA_API_URL=

# Front end (build time)
VITE_DATA=api
# VITE_API_URL=https://api.example.com   # only when the API is on another origin
# VITE_SHOW_DEMO_LOGINS=false            # hide the test-login hint on the sign-in page
