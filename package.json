{
  "name": "fatura",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fatura — Egyptian ETA e-invoicing SaaS: taxpayer workspace and platform admin panel",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:preview": "node scripts/build-preview.mjs",
    "dev:server": "tsx watch server/node.ts",
    "server": "tsx server/node.ts",
    "build:server": "node scripts/build-server.mjs server",
    "build:signer": "node scripts/build-server.mjs signer",
    "start": "node dist-server/server.mjs",
    "test:server": "vitest run server/test",
    "build:vercel": "VITE_DATA=api vite build && node scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "asn1js": "^3.0.10",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "node-forge": "^1.4.0",
    "pg": "^8.23.1",
    "pkijs": "^3.4.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
